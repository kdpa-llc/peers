{
  "name": "@kdpa-llc/peers",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane for long-lived, responsibility-driven AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdpa-llc/peers.git"
  },
  "homepage": "https://github.com/kdpa-llc/peers#readme",
  "bugs": {
    "url": "https://github.com/kdpa-llc/peers/issues"
  },
  "type": "module",
  "bin": {
    "peers": "./bin/peers.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.json": "./docs/specs/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/specs/",
    "examples/*.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "peers": "node --experimental-strip-types --no-warnings src/cli/main.ts",
    "postbuild": "node scripts/fix-declaration-imports.mjs",
    "prebuild": "node scripts/clean-dist.mjs",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
