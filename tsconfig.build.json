{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**/*.ts"]
}
